# Desenvolvimento: deixe DATABASE_URL vazio para usar PostgreSQL embarcado.
PORT=3001
APP_ORIGIN=http://localhost:5174
DATA_DIR=../../.data
DATABASE_URL=
# Defina um segredo aleatório de pelo menos 32 caracteres em produção.
COOKIE_SECRET=
# Opcional localmente; configurável para Mailpit/SMTP.
SMTP_HOST=
SMTP_PORT=1025
MAIL_FROM=Atelier Desk <atelier@localhost>
# Sem S3, os objetos ficam privados no diretório local.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=atelier-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Uploads de desenvolvimento ficam explicitamente sem varredura completa.
# Produção bloqueia uploads se o ClamAV estiver indisponível.
CLAMAV_HOST=
CLAMAV_PORT=3310
